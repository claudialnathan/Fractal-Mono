@Figures = [zero one two three four five six seven eight nine];
@Numerators = [zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr];
@Denominators = [zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom];
feature zero {
 sub uni2070 by uni2070.zero;
 sub uni2080 by uni2080.zero;
 sub zero.dnom by zero.dnom.zero;
 sub zero.numr by zero.numr.zero;
 sub zero by zero.zero;
} zero;
feature numr {
 sub @Figures by @Numerators;
} numr;
feature dnom {
 sub @Figures by @Denominators;
} dnom;
feature frac {
 sub @Figures slash' @Figures by fraction;
 rsub @Figures' fraction by @Numerators;
 rsub @Figures' @Numerators by @Numerators;
 sub fraction @Figures' by @Denominators;
 sub @Denominators @Figures' by @Denominators;
} frac;
feature sups {
 sub @Figures by [uni2070 uni00B9 uni00B2 uni00B3 uni2074 uni2075 uni2076 uni2077 uni2078 uni2079];
} sups;
feature subs {
 sub @Figures by [uni2080 uni2081 uni2082 uni2083 uni2084 uni2085 uni2086 uni2087 uni2088 uni2089];
} subs;
feature sinf {
 sub @Figures by [uni2080 uni2081 uni2082 uni2083 uni2084 uni2085 uni2086 uni2087 uni2088 uni2089];
} sinf;
feature ordn {
 sub @Figures a' by ordfeminine;
 sub @Figures o' by ordmasculine;
} ordn;
